<Window x:Class="Typr.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="{StaticResource TyprIcon}" Title="Typr — your voice, your words" Width="1180" Height="820" MinWidth="960" MinHeight="700" Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_PreviewKeyDown" UseLayoutRounding="True">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="212"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource RailBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
      <Grid Margin="18,28,18,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="10,0,0,38"><Border Background="{DynamicResource AccentBrush}" Width="35" Height="35" CornerRadius="11" Margin="0,0,10,0"><TextBlock Text="≋" Foreground="{DynamicResource AccentTextBrush}" FontSize="29" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-5,0,0"/></Border><TextBlock Text="typr" FontSize="29" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,-6,0,0"/></StackPanel>
        <StackPanel Grid.Row="1">
          <TextBlock Text="MAKE ROOM FOR YOUR WORDS" Style="{StaticResource Eyebrow}" FontSize="9" Margin="12,0,0,12"/>
          <RadioButton x:Name="WorkspaceNav" Content="⌂    Workspace" GroupName="Navigation" Style="{StaticResource NavItem}" IsChecked="True" Tag="Workspace" Checked="Nav_Checked"/>
          <RadioButton x:Name="HistoryNav" Content="◷    History" GroupName="Navigation" Style="{StaticResource NavItem}" Tag="History" Checked="Nav_Checked"/>
          <TextBlock Text="MAKE IT YOURS" Style="{StaticResource Eyebrow}" FontSize="10" Margin="12,27,0,10"/>
          <RadioButton x:Name="VocabularyNav" Content="Aa   Vocabulary" GroupName="Navigation" Style="{StaticResource NavItem}" Tag="Vocabulary" Checked="Nav_Checked"/>
          <RadioButton x:Name="SnippetsNav" Content="≡    Snippets" GroupName="Navigation" Style="{StaticResource NavItem}" Tag="Snippets" Checked="Nav_Checked"/>
          <RadioButton x:Name="AppearanceNav" Content="◐    Appearance" GroupName="Navigation" Style="{StaticResource NavItem}" Tag="Appearance" Checked="Nav_Checked"/>
          <RadioButton x:Name="SettingsNav" Content="⚙    Settings" GroupName="Navigation" Style="{StaticResource NavItem}" Tag="Settings" Checked="Nav_Checked"/>
        </StackPanel>
        <StackPanel Grid.Row="2"><Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="14" Margin="0,0,0,16"><StackPanel><TextBlock Text="YOUR WORDS, YOUR CONTROL" Style="{StaticResource Eyebrow}" FontSize="9"/><TextBlock x:Name="RailStatus" Text="Let's get you ready" FontWeight="SemiBold" FontSize="13" Margin="0,6,0,5"/><TextBlock Text="Speech stays local.&#10;AI polish is your choice." Style="{StaticResource MutedText}" FontSize="11" LineHeight="17"/></StackPanel></Border><TextBlock Text="TYPR  /  DESKTOP PREVIEW" Style="{StaticResource Eyebrow}" FontSize="9" Margin="10,0,0,0"/></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="32,0,32,0"><Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid><TextBlock x:Name="Breadcrumb" Text="Your workspace  /  Dictation" Style="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center"/><Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="{DynamicResource AccentSoftBrush}" CornerRadius="14" Padding="12,6"><TextBlock Text="●  Local speech · optional AI polish" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold"/></Border></Grid>
      <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,16"><Grid>
        <StackPanel x:Name="WorkspacePage">
          <TextBlock Text="A LITTLE MORE SPACE TO THINK" Style="{StaticResource Eyebrow}" Margin="0,12,0,10"/>
          <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Less typing. More you." FontSize="38" FontWeight="SemiBold"/><TextBlock Text="Speak naturally. Let your words find their way." Style="{StaticResource MutedText}" Margin="0,9,12,0"/></StackPanel><Button x:Name="HeroButton" Grid.Column="1" Content="Set up Typr  →" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Click="Hero_Click" Margin="12,0,0,0"/></Grid>
          <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="12" Padding="17,14" Margin="0,0,0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="ReadinessTitle" Text="Your voice, at home on your PC." FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/><TextBlock x:Name="ReadinessDetail" Text="Start with a one-time speech model download. After that, dictation works offline." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,5,12,0"/></StackPanel><Button Grid.Column="1" Content="Open setup" Style="{StaticResource QuietButton}" Click="Setup_Click" VerticalAlignment="Center"/></Grid></Border>
          <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14"><StackPanel>
            <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="A space to try your voice" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="CaptureState" Grid.Column="1" Text="MICROPHONE CLOSED" Style="{StaticResource Eyebrow}" Foreground="{DynamicResource AccentBrush}" FontSize="10" Margin="12,4,0,0"/></Grid>
            <TextBlock Text="Practice here, then hold Ctrl + Alt in any writable text field to dictate in other apps." Style="{StaticResource MutedText}" FontSize="13" Margin="0,0,0,14"/>
            <TextBox x:Name="PracticeBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96" MaxHeight="240" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" FontSize="17" Padding="16" AutomationProperties.Name="Dictation practice" ToolTip="Try saying: A little less typing gives me more time to think."/>
            <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><Button x:Name="PracticeButton" Content="Start dictation" Style="{StaticResource PrimaryButton}" Click="Practice_Click" IsEnabled="False"/><Button x:Name="CancelButton" Grid.Column="1" Content="Cancel" Click="Cancel_Click" Visibility="Collapsed" Margin="8,0,0,0"/><TextBlock x:Name="CaptureDuration" Grid.Column="2" Text="Hold Ctrl + Alt to talk" Style="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12,0"/><StackPanel Grid.Column="3" VerticalAlignment="Center"><TextBlock Text="MICROPHONE LEVEL" Style="{StaticResource Eyebrow}" FontSize="8" Margin="0,0,0,6"/><ProgressBar x:Name="MicLevel" Minimum="0" Maximum="1" Height="4"/></StackPanel></Grid>
            <TextBlock x:Name="ShortcutStatus" Text="Get set up once, then make yourself at home." Style="{StaticResource MutedText}" FontSize="12" Margin="0,14,0,0"/>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,20"><StackPanel><Grid><TextBlock Text="Your latest words" Style="{StaticResource SectionTitle}"/><Button x:Name="CopyResultButton" Content="Copy text" Click="Copy_Click" IsEnabled="False" HorizontalAlignment="Right" MinHeight="34" Padding="12,6"/></Grid><TextBlock x:Name="ResultEmpty" Text="Your finished transcript will land here. It's available to copy if insertion needs a hand." Style="{StaticResource MutedText}" FontSize="13" Margin="0,8,0,0"/><TextBox x:Name="ResultBox" Visibility="Collapsed" IsReadOnly="True" AcceptsReturn="True" MinHeight="64" MaxHeight="200" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0" AutomationProperties.Name="Latest transcript"/></StackPanel></Border>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="{DynamicResource RailBrush}" CornerRadius="12" Padding="18"><StackPanel><TextBlock Text="A shortcut to your thoughts" FontWeight="SemiBold"/><TextBlock Text="Ctrl + Alt   Hold to talk&#10;+ Space   Go hands-free&#10;Esc   Cancel before insertion" Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,0" LineHeight="23"/></StackPanel></Border><Border Grid.Column="2" Background="{DynamicResource RailBrush}" CornerRadius="12" Padding="18"><StackPanel><TextBlock Text="Your words, your way" FontWeight="SemiBold"/><TextBlock Text="Add names in Vocabulary and spoken shortcuts in Snippets. Add Shift to your shortcut for Raw output." Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,0"/></StackPanel></Border></Grid>
        </StackPanel>
        <StackPanel x:Name="HistoryPage" Visibility="Collapsed">
          <TextBlock Text="Every thought, within reach." FontSize="30" FontWeight="SemiBold" Margin="0,20,0,8"/><TextBlock Text="Find a thought. Hear it again. Give it another pass." Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
          <TextBlock x:Name="HistorySummary" Style="{StaticResource Eyebrow}" Margin="0,0,0,20"/>
          <Border Style="{StaticResource Card}"><StackPanel><CheckBox x:Name="HistoryEnabledBox" Content="Save transcript history on this PC" Click="Preferences_Click"/><TextBlock Text="Keeps your latest 200 completed transcripts. Turning this off stops new saves; existing entries remain until you remove them." Style="{StaticResource MutedText}" FontSize="12" Margin="0,2,0,18"/><TextBlock Text="Search your transcripts" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8"/><TextBox x:Name="HistorySearchBox" AutomationProperties.Name="Search transcript history" TextChanged="HistorySearch_Changed" Margin="0,0,0,16"/>
            <TextBlock x:Name="HistoryEmpty" Text="A fresh start. Your saved transcripts will appear here." Style="{StaticResource MutedText}" Margin="0,16,0,24"/>
            <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ListBox x:Name="HistoryList" MaxHeight="480" VerticalAlignment="Top" SelectionChanged="History_SelectionChanged" AutomationProperties.Name="Saved transcripts"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="AutomationProperties.Name" Value="{Binding Preview}"/></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding DisplayDate}" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding Preview}" TextWrapping="Wrap" MaxHeight="72" TextTrimming="CharacterEllipsis" Margin="0,6,0,5"/><TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" FontSize="11"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
            <StackPanel Grid.Column="2">
            <TextBlock x:Name="HistoryMetadata" Style="{StaticResource MutedText}" FontSize="12" Margin="0,18,0,0"/>
            <TextBox x:Name="HistoryDetail" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="180" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Margin="0,14,0,12" AutomationProperties.Name="Selected transcript"/>
            <Expander Header="Original recognition" Margin="0,10,0,10"><TextBox x:Name="HistoryRawDetail" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="180" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0" AutomationProperties.Name="Original recognition"/></Expander>
            <WrapPanel Margin="0,12,0,0"><Button x:Name="CopyHistoryButton" Content="Copy selected" Click="CopyHistory_Click" IsEnabled="False" Margin="0,0,8,6"/><Button x:Name="PasteHistoryButton" Content="Paste selected" Click="PasteHistory_Click" IsEnabled="False" Margin="0,0,8,6"/><Button x:Name="RePolishHistoryButton" Content="Re-polish with selected AI" Click="RePolishHistory_Click" IsEnabled="False" Margin="0,0,8,6"/><Button x:Name="RestoreHistoryButton" Content="Restore previous" Click="RestoreHistory_Click" IsEnabled="False" Margin="0,0,8,6"/><Button x:Name="RemoveHistoryButton" Content="Remove selected" Click="RemoveHistory_Click" IsEnabled="False" Margin="0,0,8,6"/><Button x:Name="ClearHistoryButton" Content="Clear all history" Style="{StaticResource DangerButton}" Click="ClearHistory_Click" Margin="0,0,0,6"/></WrapPanel>
            </StackPanel></Grid>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}" Margin="0,18,0,0"><StackPanel><TextBlock Text="Listen again. Catch more." Style="{StaticResource SectionTitle}"/><TextBlock x:Name="HistoryAudioStatus" Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,14"/><WrapPanel><Button x:Name="ListenHistoryButton" Content="Play recording" Click="ListenHistory_Click" IsEnabled="False" Margin="0,0,8,8"/><Button Content="Stop playback" Click="StopHistoryAudio_Click" Margin="0,0,8,8"/></WrapPanel>
            <ComboBox x:Name="RetranscriptionModelBox" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="RetranscriptionModel_Changed" AutomationProperties.Name="Audio re-transcription model" Margin="0,10,0,10"/>
            <TextBlock Text="Small: recommended for CPU, 375 MB. Large v3: quality option, 1.78 GB, more RAM and time. Both recognize multiple languages. AI polish keeps Hindi in Roman text when enabled. The live recognizer remains English; Hindi recognition is best handled by re-transcribing retained audio." Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,14"/>
            <WrapPanel><Button x:Name="DownloadRetranscriptionButton" Content="Download selected model" Click="DownloadRetranscription_Click" Margin="0,0,8,8"/><Button x:Name="RetranscribeHistoryButton" Content="Re-transcribe recording" Style="{StaticResource PrimaryButton}" Click="RetranscribeHistory_Click" IsEnabled="False" Margin="0,0,8,8"/><Button x:Name="CancelHistoryButton" Content="Cancel operation" Click="CancelHistory_Click" Visibility="Collapsed" Margin="0,0,0,8"/></WrapPanel><ProgressBar x:Name="HistoryProgress" Minimum="0" Maximum="1" Height="4" Margin="0,8,0,12"/><TextBlock x:Name="HistoryOperationStatus" Text="Choose a provider and model in Settings for re-polishing. Re-transcription requires a retained recording." Style="{StaticResource MutedText}" FontSize="12" AutomationProperties.LiveSetting="Polite"/>
          </StackPanel></Border>
          <Border x:Name="HistoryPreviewPanel" Style="{StaticResource Card}" Visibility="Collapsed" Margin="0,18,0,0"><StackPanel><TextBlock Text="Your next version" Style="{StaticResource SectionTitle}"/><TextBlock Text="Review and edit before applying. Your previous text remains recoverable." Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,12"/><TextBox x:Name="HistoryPreviewText" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" MaxHeight="280" MaxLength="100000" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="New transcript preview"/><WrapPanel Margin="0,14,0,0"><Button Content="Apply new version" Style="{StaticResource PrimaryButton}" Click="ApplyHistoryPreview_Click" Margin="0,0,8,0"/><Button Content="Discard preview" Click="DiscardHistoryPreview_Click"/></WrapPanel></StackPanel></Border>
        </StackPanel>
        <StackPanel x:Name="VocabularyPage" Visibility="Collapsed">
          <TextBlock Text="Make every word yours." FontSize="30" FontWeight="SemiBold" Margin="0,20,0,8"/><TextBlock Text="The names, projects and little details that matter to you." Style="{StaticResource MutedText}" Margin="0,0,0,24"/>
          <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Teach Typr a spelling" Style="{StaticResource SectionTitle}"/><TextBlock Text="For example, replace “type er” with “Typr”. Rules correct completed text in Clean mode; they don't retrain the speech model." Style="{StaticResource MutedText}" FontSize="13" Margin="0,0,0,20"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="When I say" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBox x:Name="VocabularyPhrase" MaxLength="200" AutomationProperties.Name="Vocabulary spoken phrase"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Write as" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBox x:Name="VocabularyReplacement" MaxLength="10000" AutomationProperties.Name="Vocabulary preferred spelling"/></StackPanel></Grid>
            <Button Content="Add to vocabulary" Style="{StaticResource PrimaryButton}" Click="AddVocabulary_Click" HorizontalAlignment="Left" Margin="0,18,0,0"/><TextBlock x:Name="VocabularyFeedback" Style="{StaticResource MutedText}" AutomationProperties.LiveSetting="Polite" FontSize="12" Margin="0,12,0,0"/>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Your vocabulary" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="VocabularyEmpty" Text="Start with a name your recognizer often misses." Style="{StaticResource MutedText}" Margin="0,8,0,16"/><ListBox x:Name="VocabularyList" ItemTemplate="{StaticResource RuleTemplate}" MaxHeight="280" AutomationProperties.Name="Vocabulary rules"/><Button Content="Remove selected word" Click="RemoveVocabulary_Click" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></Border>
        </StackPanel>
        <StackPanel x:Name="SnippetsPage" Visibility="Collapsed">
          <TextBlock Text="Say a little. Write a lot." FontSize="30" FontWeight="SemiBold" Margin="0,20,0,8"/><TextBlock Text="Turn a spoken phrase into the text you reach for again and again." Style="{StaticResource MutedText}" Margin="0,0,0,24"/>
          <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Create a spoken shortcut" Style="{StaticResource SectionTitle}"/><TextBlock Text="Say “my signature” for a sign-off, or “meeting link” for a URL. Expansions are literal text and only run in Clean mode." Style="{StaticResource MutedText}" FontSize="13" Margin="0,0,0,18"/><TextBlock Text="Spoken phrase" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBox x:Name="SnippetPhrase" MaxLength="200" AutomationProperties.Name="Snippet spoken phrase"/><TextBlock Text="Expand to" FontSize="12" FontWeight="SemiBold" Margin="0,16,0,8"/><TextBox x:Name="SnippetReplacement" MaxLength="10000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" MaxHeight="220" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Snippet expansion"/><Button Content="Create snippet" Style="{StaticResource PrimaryButton}" Click="AddSnippet_Click" HorizontalAlignment="Left" Margin="0,18,0,0"/><TextBlock x:Name="SnippetFeedback" Style="{StaticResource MutedText}" AutomationProperties.LiveSetting="Polite" FontSize="12" Margin="0,12,0,0"/></StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Your snippets" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="SnippetsEmpty" Text="Your favorite phrases, with a little less repetition." Style="{StaticResource MutedText}" Margin="0,8,0,16"/><ListBox x:Name="SnippetsList" ItemTemplate="{StaticResource RuleTemplate}" MaxHeight="260" AutomationProperties.Name="Spoken snippets"/><Button Content="Remove selected snippet" Click="RemoveSnippet_Click" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></Border>
        </StackPanel>
        <StackPanel x:Name="AppearancePage" Visibility="Collapsed">
          <TextBlock Text="Feels like you." FontSize="30" FontWeight="SemiBold" Margin="0,20,0,8"/><TextBlock Text="A quieter workspace, in your colors. Changes apply as you go." Style="{StaticResource MutedText}" Margin="0,0,0,24"/>
          <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Set the mood" Style="{StaticResource SectionTitle}"/>
            <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Theme" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/><ComboBox x:Name="ThemeBox" SelectionChanged="Appearance_Changed" AutomationProperties.Name="Color theme"><ComboBoxItem Content="System"/><ComboBoxItem Content="Light"/><ComboBoxItem Content="Dark"/></ComboBox></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Accent color" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/><ComboBox x:Name="AccentBox" SelectionChanged="Appearance_Changed" AutomationProperties.Name="Accent color"><ComboBoxItem Content="Iris"/><ComboBoxItem Content="Forest"/><ComboBoxItem Content="Ocean"/></ComboBox></StackPanel></Grid>
            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="12" Padding="20" Margin="0,22,0,0"><StackPanel><TextBlock Text="A little space for a big idea." FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="Your theme follows you throughout Typr." Style="{StaticResource MutedText}" Margin="0,7,0,0"/></StackPanel></Border>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Silk companion bar" Style="{StaticResource SectionTitle}"/><TextBlock Text="A thin capsule with sound-responsive marks and finishing dots. It grows only on hover, up to twice its resting size. Transparency changes the background while icons stay solid." Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,18"/>
            <Grid Margin="0,0,0,8"><TextBlock Text="Bar background opacity" FontSize="12" FontWeight="SemiBold"/><TextBlock x:Name="BarOpacityValue" Text="{Binding Value, ElementName=BarOpacitySlider, StringFormat={}{0:P0}}" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" FontSize="12"/></Grid>
            <Slider x:Name="BarOpacitySlider" Minimum="0.2" Maximum="1" Value="0.78" TickFrequency="0.01" IsSnapToTickEnabled="True" SmallChange="0.01" LargeChange="0.1" ValueChanged="BarPresentation_Changed" AutomationProperties.Name="Companion bar background opacity" Margin="0,4,0,20"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Bar size" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/><ComboBox x:Name="BarScaleBox" SelectionChanged="BarPresentation_Changed" AutomationProperties.Name="Companion bar size"><ComboBoxItem Content="Small · 85%"/><ComboBoxItem Content="Standard · 100%"/><ComboBoxItem Content="Large · 115%"/></ComboBox></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Show hover actions after" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/><ComboBox x:Name="BarHoverDelayBox" SelectionChanged="BarPresentation_Changed" AutomationProperties.Name="Companion bar hover delay"><ComboBoxItem Content="Immediately"/><ComboBoxItem Content="150 ms"/><ComboBoxItem Content="300 ms"/><ComboBoxItem Content="500 ms"/></ComboBox></StackPanel></Grid>
            <CheckBox x:Name="AllowButtonRecordingBox" Content="Allow starting dictation from the bar and buttons" Click="BarButtonRecording_Click" Margin="0,20,0,4"/><TextBlock Text="Off by default: use a dictation shortcut to open the microphone. Finish and Cancel remain available on the bar. Preparing speech only loads the local model." Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,14"/>
            <Button Content="Reset bar appearance" Click="ResetBarAppearance_Click" HorizontalAlignment="Left"/><TextBlock Text="Motion runs during listening, finishing and brief transitions. Idle stays still. High contrast keeps the background solid." Style="{StaticResource MutedText}" FontSize="11" Margin="0,12,0,0"/>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="While you're speaking" Style="{StaticResource SectionTitle}"/><CheckBox x:Name="CaptionsBox" Content="Show live captions" Click="Preferences_Click"/><CheckBox x:Name="BarVisibleBox" Content="Show the movable companion bar" Click="Preferences_Click"/><TextBlock Text="The floating overlay never takes focus from the app you're writing in." Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,18"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Caption background" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/><ComboBox x:Name="CaptionOpacityBox" SelectionChanged="Preferences_Changed" AutomationProperties.Name="Caption background opacity"><ComboBoxItem Content="Readable · 60%" Tag="0.6"/><ComboBoxItem Content="Balanced · 85%" Tag="0.85"/><ComboBoxItem Content="Solid · 100%" Tag="1"/></ComboBox></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Caption lines" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/><ComboBox x:Name="CaptionLinesBox" SelectionChanged="Preferences_Changed" AutomationProperties.Name="Maximum caption lines"><ComboBoxItem Content="1 line"/><ComboBoxItem Content="2 lines"/><ComboBoxItem Content="3 lines"/></ComboBox></StackPanel></Grid>
          </StackPanel></Border>
        </StackPanel>
        <StackPanel x:Name="SettingsPage" Visibility="Collapsed">
          <TextBlock Text="Ready when you are." FontSize="30" FontWeight="SemiBold" Margin="0,20,0,8"/><TextBlock Text="Set up local speech once. Keep control of how Typr works." Style="{StaticResource MutedText}" Margin="0,0,0,24"/>
          <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="01  /  Bring your voice home" Style="{StaticResource SectionTitle}"/><TextBlock Text="Recommended: Nemotron English · runs on your CPU. One-time download of about 632 MiB from Hugging Face; no account or API key. Dictation then works offline." Style="{StaticResource MutedText}" FontSize="13" Margin="0,0,0,18"/>
            <WrapPanel><Button x:Name="DownloadButton" Content="Download speech model" Style="{StaticResource PrimaryButton}" Click="Download_Click" Margin="0,0,8,8"/><Button x:Name="LoadButton" Content="Prepare speech" Click="Load_Click" Margin="0,0,8,8"/><Button x:Name="PauseButton" Content="Unload speech" Click="Pause_Click" IsEnabled="False" Margin="0,0,0,8"/></WrapPanel><ProgressBar x:Name="DownloadProgress" Minimum="0" Maximum="1" Margin="0,12,0,12"/><TextBlock x:Name="ModelStatus" Text="Speech model is not loaded." Style="{StaticResource MutedText}" AutomationProperties.LiveSetting="Polite" FontSize="12"/>
            <Expander Header="Advanced model settings" Margin="0,18,0,0" Foreground="{DynamicResource MutedBrush}"><StackPanel Margin="0,12,0,0"><TextBlock Text="Existing model folder" FontSize="12" Margin="0,0,0,8"/><TextBox x:Name="ModelPathBox" AutomationProperties.Name="Speech model folder" ToolTip="Folder containing encoder.int8.onnx, decoder.int8.onnx, joiner.int8.onnx and tokens.txt"/><TextBlock Text="CPU threads · change while speech is unloaded" Style="{StaticResource MutedText}" FontSize="12" Margin="0,14,0,8"/><ComboBox x:Name="ThreadCountBox" Width="100" HorizontalAlignment="Left" SelectedIndex="0" AutomationProperties.Name="CPU threads"><ComboBoxItem Content="2"/><ComboBoxItem Content="4"/></ComboBox></StackPanel></Expander>
            <TextBlock Text="Recording input" FontWeight="SemiBold" FontSize="12" Margin="0,18,0,8"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="InputDeviceBox" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="InputDevice_Changed" AutomationProperties.Name="Recording input" ToolTip="Unload speech to change the input. This does not change Windows defaults."/><Button Grid.Column="2" x:Name="RefreshInputsButton" Content="Refresh inputs" Click="RefreshInputs_Click"/></Grid>
            <TextBlock x:Name="InputDeviceStatus" Text="Choose a built-in or USB input to keep Bluetooth headset playback quality. Bluetooth Classic switches its audio profile when any app uses the headset microphone." Style="{StaticResource MutedText}" FontSize="11" Margin="0,8,0,0"/>
            <TextBlock Text="Your microphone is off while idle, including after preparing speech. A recording shortcut opens it; finish, release or cancel closes it after a short 300 ms tail. Typr uses shared input and does not change Windows defaults, mute controls, output audio or other apps." Style="{StaticResource MutedText}" FontSize="12" Margin="0,18,0,0"/>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="02  /  Words that sound like you" Style="{StaticResource SectionTitle}"/><TextBlock Text="Clean applies your vocabulary, snippets and optional AI polish. It fixes punctuation, numbers, lists and spoken corrections while preserving your meaning and Roman Hindi. Raw keeps the recognized words." Style="{StaticResource MutedText}" FontSize="13" Margin="0,0,0,16"/><ComboBox x:Name="OutputModeBox" SelectionChanged="Preferences_Changed" AutomationProperties.Name="Default output mode"><ComboBoxItem Content="Clean · personal rules and optional AI polish"/><ComboBoxItem Content="Raw · recognized words only"/></ComboBox><CheckBox x:Name="AutoPasteBox" Content="Automatically paste into the field where I started" Click="CompanionPreferences_Click" Margin="0,16,0,4"/><CheckBox x:Name="AiPolishBox" Content="Polish Clean output with my AI subscription" Click="CompanionPreferences_Click"/>
            <TextBlock Text="AI polish sends recognized text to your selected provider. Audio recognition stays on this PC. If the provider cannot finish, Typr keeps your locally cleaned text and tells you." Style="{StaticResource MutedText}" FontSize="12" Margin="0,5,0,0"/>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="03  /  Your AI, already connected" Style="{StaticResource SectionTitle}"/><TextBlock Text="Use your own ChatGPT or Claude sign-in through the provider's official local CLI. Sign-in stays with the provider. Typr doesn't collect subscription tokens or switch to paid API credits." Style="{StaticResource MutedText}" FontSize="13" Margin="0,0,0,16"/>
            <TextBlock Text="Provider priority" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8"/><ComboBox x:Name="ProviderPriorityBox" SelectionChanged="ProviderPreferences_Changed" AutomationProperties.Name="AI provider priority"><ComboBoxItem Content="ChatGPT only"/><ComboBoxItem Content="Claude only"/><ComboBoxItem Content="ChatGPT first"/><ComboBoxItem Content="Claude first"/></ComboBox>
            <TextBlock Text="A ‘first’ preference allows fallback to the other connected provider. The controls below configure the first provider; switch priority to configure the other one." Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,16"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Model" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8"/><ComboBox x:Name="ProviderModelBox" IsEditable="True" DisplayMemberPath="DisplayName" SelectionChanged="ProviderPreferences_Changed" LostKeyboardFocus="ProviderModel_LostFocus" AutomationProperties.Name="Polishing model"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Reasoning effort" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8"/><ComboBox x:Name="ReasoningBox" SelectionChanged="ProviderPreferences_Changed" AutomationProperties.Name="Polishing reasoning effort"/></StackPanel></Grid>
            <TextBlock Text="Default: GPT-6 Luna · low. Refresh lists the models your provider exposes. Choose another model or compare efforts below." Style="{StaticResource MutedText}" FontSize="12" Margin="0,10,0,16"/><TextBlock x:Name="ProviderStatus" Text="Connection will be checked when Typr opens." Style="{StaticResource MutedText}" FontSize="12" AutomationProperties.LiveSetting="Polite"/><TextBlock x:Name="ProviderVersion" Style="{StaticResource MutedText}" FontSize="11" Margin="0,6,0,14"/>
            <WrapPanel><Button x:Name="ConnectProviderButton" Content="Sign in / reconnect" Style="{StaticResource PrimaryButton}" Click="ConnectProvider_Click" Margin="0,0,8,8"/><Button x:Name="RefreshProviderButton" Content="Refresh connection and models" Click="RefreshProviders_Click" Margin="0,0,8,8"/><Button x:Name="CheckProviderUpdateButton" Content="Check CLI update" Click="CheckProviderUpdate_Click" Margin="0,0,8,8"/><Button x:Name="CancelProviderButton" Content="Cancel sign-in / comparison" Click="CancelProvider_Click" Visibility="Collapsed" Margin="0,0,8,8"/><Button x:Name="UpdateProviderButton" Content="Install / update CLI" Click="UpdateProvider_Click" Margin="0,0,0,8"/></WrapPanel>
            <Expander Header="Compare reasoning on the same words" Margin="0,12,0,0"><StackPanel Margin="0,12,0,0"><TextBlock Text="Each run uses subscription allowance. Compare output and elapsed time on your own sample; a single run is not a reliable speed benchmark." Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,12"/><TextBox x:Name="BenchmarkInputBox" Text="kal mujhe 3 reports bhejna actually 4 reports at 4 30 pm list first finish the design second test the microphone third send 25 invites" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" MaxLength="20000" AutomationProperties.Name="Reasoning comparison sample"/><Button x:Name="CompareReasoningButton" Content="Compare supported efforts" Click="CompareReasoning_Click" HorizontalAlignment="Left" Margin="0,12,0,12"/><TextBox x:Name="BenchmarkResultBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="400" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Reasoning comparison results"/></StackPanel></Expander>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="04  /  A companion within reach" Style="{StaticResource SectionTitle}"/><TextBlock Text="Show or hide Silk and live text in Appearance. Drag anywhere on the bar, including its controls. Hover shows up to four chosen actions; additional hover actions appear under More alongside your right-click choices. Live text appears above the bar." Style="{StaticResource MutedText}" FontSize="13" Margin="0,0,0,16"/>
            <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="105"/><ColumnDefinition Width="105"/></Grid.ColumnDefinitions><TextBlock Text="Action" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="On hover" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="Right-click" FontWeight="SemiBold"/></Grid><StackPanel x:Name="BarOptionsPanel"/><Button Content="Return bar to bottom center" Click="ResetBarPosition_Click" HorizontalAlignment="Left" Margin="0,16,0,0"/>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="05  /  Shortcuts that fit your hands" Style="{StaticResource SectionTitle}"/><CheckBox x:Name="CommandShortcutsBox" Content="Enable dictation keyboard shortcuts" Click="CompanionPreferences_Click"/><TextBlock Text="Hold Ctrl + Alt to talk; release either key to finish. Add Shift for Raw, or Space for hands-free. Start / finish toggles recording. The first use prepares speech; wait for Listening before speaking. Esc cancels, including during preparation. Uncheck to release recording and paste shortcuts." Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,18"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Prepare / unload speech" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8"/><ComboBox x:Name="MicrophoneShortcutBox" SelectionChanged="Shortcut_Changed" AutomationProperties.Name="Prepare speech shortcut"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Start / finish" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8"/><ComboBox x:Name="HandsFreeShortcutBox" SelectionChanged="Shortcut_Changed" AutomationProperties.Name="Hands-free shortcut"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="Paste last" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8"/><ComboBox x:Name="PasteShortcutBox" SelectionChanged="Shortcut_Changed" AutomationProperties.Name="Paste last shortcut"/></StackPanel></Grid><TextBlock x:Name="ShortcutConfigurationStatus" Style="{StaticResource MutedText}" FontSize="12" Margin="0,14,0,0"/>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="06  /  Keep what you choose" Style="{StaticResource SectionTitle}"/><CheckBox x:Name="AudioRetentionBox" Content="Keep up to 200 completed audio recordings locally" Click="Preferences_Click"/><TextBlock Text="Off by default for new profiles. Enables playback and re-transcription for future recordings. Cancelled recordings are discarded. Turning this off prevents future audio saves; it doesn't erase older files." Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,14"/><TextBlock Text="Settings: %APPDATA%\Typr. History, retained audio and models: %LOCALAPPDATA%\Typr. History and audio have independent 200-item limits; removing a transcript does not delete its recording. With AI polish enabled, recognized text is sent to the provider you select." Style="{StaticResource MutedText}" FontSize="12"/><WrapPanel Margin="0,16,0,0"><Button Content="Open local data" Click="Data_Click" Margin="0,0,8,6"/><Button Content="Open diagnostics" Click="Logs_Click" Margin="0,0,0,6"/></WrapPanel></StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="System requirements" Style="{StaticResource SectionTitle}"/><TextBlock Text="Windows 10 or 11, 64-bit x64 · microphone · writable text field. Practical baseline: 8 GB RAM, 2 GB free storage, 4 CPU cores. Large v3: 16 GB RAM and 4 GB additional free space recommended. Internet is needed for model downloads, provider sign-in and AI polish. Local speech works offline after download. The self-contained download includes the .NET runtime. ARM, macOS and Linux builds are not available." Style="{StaticResource MutedText}" FontSize="13" Margin="0,8,0,0"/><TextBlock Text="Hardware figures are a practical starting point, not a certified minimum benchmark. Typr cannot insert into protected, password, read-only or higher-privilege fields. Copy text remains available." Style="{StaticResource MutedText}" FontSize="12" Margin="0,12,0,0"/></StackPanel></Border>
        </StackPanel>
      </Grid></ScrollViewer>
      <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,13"><TextBlock x:Name="StatusText" Text="Welcome to Typr. Make room for your words." Style="{StaticResource MutedText}" FontSize="11" AutomationProperties.LiveSetting="Polite"/></Border>
    </Grid>
  </Grid>
</Window>
