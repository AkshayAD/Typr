<Window x:Class="Ava.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Ava • Voice dictation pilot" Width="980" Height="780" MinWidth="800" MinHeight="640" Background="#0C1420" Foreground="#EEF4FF" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="32">
      <DockPanel Margin="0,0,0,24">
        <StackPanel><TextBlock Text="Ava" FontSize="35" FontWeight="SemiBold"/><TextBlock Text="Your words, ready to go." Foreground="#8EABC4" FontSize="16"/></StackPanel>
        <Border Background="#23334A" CornerRadius="10" Padding="12,6" HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock Text="PHASE 1 · WINDOWS PILOT" FontSize="11" FontWeight="SemiBold"/></Border>
      </DockPanel>
      <Border Background="#192B3C" CornerRadius="12" Padding="16" Margin="0,0,0,20">
        <TextBlock Text="This build uses local speech recognition and deterministic cleanup. AI polish, voice edit, tray/bar, history browsing, and installation are later phases. Windows microphone, accuracy, latency, and paste behavior still need on-device validation." Foreground="#BFD4E9"/>
      </Border>
      <Border Background="{StaticResource Panel}" CornerRadius="14" Padding="22" Margin="0,0,0,18">
        <StackPanel>
          <TextBlock Text="1  Set up local speech" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBlock Text="Nemotron EN 0.6B · CPU · approximately 632 MiB. Downloaded only when you choose. No API key or paid service." Foreground="#93ADC6" Margin="0,0,0,12"/>
          <TextBox x:Name="ModelPathBox" ToolTip="Folder containing encoder.int8.onnx, decoder.int8.onnx, joiner.int8.onnx, and tokens.txt" Margin="0,0,0,12"/>
          <WrapPanel Margin="0,0,0,12">
            <Button x:Name="DownloadButton" Content="Download speech model" Click="Download_Click"/>
            <Button x:Name="LoadButton" Content="Load model + open mic" Click="Load_Click"/>
            <Button x:Name="PauseButton" Content="Close mic" Click="Pause_Click" IsEnabled="False"/>
            <TextBlock Text="CPU threads" VerticalAlignment="Center" Margin="4,0,8,0"/>
            <ComboBox x:Name="ThreadCountBox" Width="55" SelectedIndex="0" VerticalContentAlignment="Center"><ComboBoxItem Content="2"/><ComboBoxItem Content="4"/></ComboBox>
          </WrapPanel>
          <ProgressBar x:Name="DownloadProgress" Height="5" Minimum="0" Maximum="1" Margin="0,0,0,10"/>
          <TextBlock x:Name="ModelStatus" Text="Speech model is not loaded." Foreground="#A9C0D9"/>
          <ProgressBar x:Name="MicLevel" Height="6" Minimum="0" Maximum="1" Margin="0,12,0,0" Foreground="#47DFA5"/>
        </StackPanel>
      </Border>
      <Border Background="{StaticResource Panel}" CornerRadius="14" Padding="22" Margin="0,0,0,18">
        <StackPanel>
          <TextBlock Text="2  Try it here, then in another app" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,12"/>
          <UniformGrid Columns="2" Margin="0,0,0,14">
            <TextBlock Text="Ctrl + Alt     Hold to talk" Margin="0,0,0,10"/>
            <TextBlock Text="+ Shift     Raw mode (sticky)" Margin="0,0,0,10"/>
            <TextBlock Text="+ Space     Hands-free; same chord finishes"/>
            <TextBlock Text="Esc     Cancel recording"/>
          </UniformGrid>
          <TextBox x:Name="PracticeBox" AcceptsReturn="True" MinHeight="115" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Ava dictation practice box"/>
          <TextBlock x:Name="ShortcutStatus" Text="Click the practice box, then hold Ctrl + Alt and speak." Foreground="#91ABC6" Margin="0,12,0,0"/>
          <TextBlock Text="Ctrl + Shift + Z pastes the latest result again. Voice-edit shortcuts are recognized but never applied in this phase." Foreground="#91ABC6" FontSize="12" Margin="0,7,0,0"/>
        </StackPanel>
      </Border>
      <Border Background="{StaticResource Panel}" CornerRadius="14" Padding="22">
        <StackPanel>
          <TextBlock Text="Latest result" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,10"/>
          <TextBox x:Name="ResultBox" IsReadOnly="True" AcceptsReturn="True" MinHeight="80" MaxHeight="190" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"/>
          <WrapPanel><Button Content="Copy result" Click="Copy_Click"/><Button Content="Clear practice" Click="Clear_Click"/><Button Content="Open local logs" Click="Logs_Click"/></WrapPanel>
          <TextBlock x:Name="StatusText" Text="Ready for setup." Foreground="#9CB8D3" Margin="0,12,0,0"/>
          <TextBlock Text="Audio stays on this PC: up to 200 WAV recordings under %LOCALAPPDATA%\Ava\audio. The warmed microphone stays open for pre-roll until you close it or quit. Logs contain delivery diagnostics, never dictated text." Foreground="#7E97B0" FontSize="12" Margin="0,12,0,0"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Window>
