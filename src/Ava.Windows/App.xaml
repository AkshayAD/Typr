<Application x:Class="Ava.Windows.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <SolidColorBrush x:Key="Panel" Color="#17202C"/>
    <Style TargetType="Button"><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="0,0,9,0"/><Setter Property="Background" Value="#24354B"/><Setter Property="Foreground" Value="#F5F7FB"/><Setter Property="BorderBrush" Value="#3F5570"/></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="10"/><Setter Property="Background" Value="#0B121D"/><Setter Property="Foreground" Value="#EEF4FF"/><Setter Property="BorderBrush" Value="#344559"/><Setter Property="SelectionBrush" Value="#456F9E"/></Style>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  </Application.Resources>
</Application>
